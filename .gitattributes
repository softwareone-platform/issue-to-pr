# Treat binary assets as binary — never apply text / end-of-line normalization
# (CRLF<->LF conversion corrupts binary files such as PNGs).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.woff  binary
*.woff2 binary

# Markdown / JSON / source stay text with LF in the repo (quiets the CRLF warnings)
*.md   text eol=lf
*.json text eol=lf
*.py   text eol=lf
*.tmpl text eol=lf
